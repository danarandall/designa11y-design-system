    "url": "https://github.com/emilkowalski/skills/blob/main/skills/find-animation-opportunities/SKILL.md",
    "use": "Evaluation reference, not installed skill; no blanket adoption of its defaults",
    "reviewDate": "2026-10-18",
    "adaptations": [
      "Allow static reduced-motion alternatives; do not require residual animation",
      "Do not gate useful keyboard feedback solely by input modality; preserve immediate semantics",
      "Do not introduce hold-to-confirm as a default; provide accessible confirmation and cancellation patterns"
    ]
  },
  "defaults": {
    "focus": "Static approved triple stroke; never animate focus traversal",
    "semantics": "Update semantic state immediately; animation never gates focus or activation",
    "interruption": "Retarget from current state, cancel stale completion and avoid queued repetitions",
    "reducedMotion": "Remove spatial movement and provide immediate static feedback; opacity-only feedback is optional only when appropriate",
    "hover": "Fine pointer with hover capability; equal information for keyboard and touch",
    "evidence": "Recipes are authored proposals unless explicitly approved; no native timeline or runtime implementation claimed"
  },
